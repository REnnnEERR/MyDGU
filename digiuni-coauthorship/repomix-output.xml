                    <label key={r} className="flex items-center gap-2 text-sm p-1 hover:bg-du-gray-50 rounded-lg cursor-pointer">
                      <input type="checkbox" checked={myRoles.includes(r)} onChange={() => handleRoleChange(r)} /> {r}
